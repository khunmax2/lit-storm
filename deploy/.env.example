# Copy to .env and fill in. One file for the whole stack — it used to be
# three, which is how a key changed in one place stayed stale in another.
#
# What the app reads here is what secrets.toml holds for a host run: the
# image carries no secrets.toml, and `auth.setting` falls through to the
# environment precisely so that it does not have to.
#
# One rule worth knowing: a value in secrets.toml cannot be overridden by an
# environment variable, only the other way round. That is not a problem here,
# because there is no secrets.toml in the container.

# --- Supabase ---------------------------------------------------------------
# Left unset the compose file supplies http://gateway:8000, which is Supabase
# by service name. Set it only to point somewhere else.
# SUPABASE_URL=http://gateway:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Postgres and the signing secret the whole stack shares. Generate both;
# neither has a sensible default.
POSTGRES_PASSWORD=
JWT_SECRET=

# --- Models -----------------------------------------------------------------
# Only what this deployment uses. The Models page writes the rest into the
# app-state volume, where it survives a restart and a new image.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# --- Embeddings, if Co-STORM is used ----------------------------------------
# ollama runs on this machine rather than in the stack, so it is reached
# through host.docker.internal — the compose file maps that to the host.
# ENCODER_PROVIDER=ollama
# OLLAMA_API_BASE=http://host.docker.internal:11434
# OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# --- Search -----------------------------------------------------------------
# SearXNG by service name.
# SEARXNG_URL=http://searxng:8080
# TAVILY_API_KEY=
# Signs SearXNG's sessions and CSRF tokens. Generate one for a deployment.
# SEARXNG_SECRET=

# --- Deep Research UI --------------------------------------------------------
# Its own model settings. They do not follow the app's: this is a separate
# application with one model slot rather than a fast/strong pair.
NUXT_PUBLIC_SERVER_MODE=true
NUXT_PUBLIC_AI_PROVIDER=openai-compatible
NUXT_AI_API_BASE=https://openrouter.ai/api/v1
NUXT_AI_API_KEY=
NUXT_PUBLIC_AI_MODEL=deepseek/deepseek-v4.1-flash
NUXT_PUBLIC_AI_CONTEXT_SIZE=128000
NUXT_PUBLIC_WEB_SEARCH_PROVIDER=searxng
# Left unset the compose file supplies http://searxng:8080.
# NUXT_WEB_SEARCH_API_BASE=http://searxng:8080

# --- Never set this in a deployment -----------------------------------------
# STORM_DEV_USER skips sign-in. It belongs to a laptop and nowhere else.
# STORM_DEV_USER=1

# --- Agent Research (the fourth engine) ---------------------------------------
# Its own models. It shares the OpenRouter key above but not the Models page:
# it is a separate application. Its fast model drives tool calls, and not
# every model that works for STORM works here — llama-4-scout 404s on this
# library's tool calls where gpt-4o-mini does not.
# AGENTS_REASONING_MODEL=deepseek/deepseek-v4.1-flash
# AGENTS_MAIN_MODEL=deepseek/deepseek-v4.1-flash
# AGENTS_FAST_MODEL=openai/gpt-4o-mini

# --- Optional overrides ------------------------------------------------------
# Every one of these has a working default in docker-compose.yml. Listed so
# that they can be found without reading it.
# LIT_STORM_PORT=8501
# LIT_STORM_IMAGE=lit-storm/app:dev
# SUPABASE_PORT=8000
# SearXNG's published port. 8080 is heavily contended; change it if
# another stack on this machine already publishes there.
# SEARXNG_PORT=8080
# RESEARCH_UI_BASE_PATH=/
# AGENTS_RESEARCH_PORT=3200
# AGENTS_RESEARCH_IMAGE=lit-storm/agents-research:dev
# The research UI's GHCR package is private until its visibility is set to
# public, so a local build is the override until then:
# RESEARCH_UI_IMAGE=lit-storm/research-ui:searxng
