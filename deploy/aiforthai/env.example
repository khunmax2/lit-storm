# The ENV_FILE CI variable (Settings > CI/CD > Variables: type File, Protected,
# environments All, "Expand variable reference" off). Copy this,
# replace every CHANGE_ME, paste the whole text as the variable's value.
# Never commit the filled copy. One KEY=value per line, no quotes, no spaces
# around "=".
#
# New secrets:   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Fernet keys:   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- where and how (confirmed by the aiforthai administrators) ---
COMPOSE_PROJECT_NAME=deeplit
DATA_PATH=/home/search/Thoughtmind/deeplit/data
APP_PORT=10370
PUBLIC_URL=https://deeplit.aiforthai.in.th

# --- DeepLit ---
# Encrypts the provider keys stored in the database: keep a copy off the
# machine, losing it makes them unreadable (a Fernet key).
LITSTORM_SECRET_KEY=CHANGE_ME
# Typed once at https://deeplit.aiforthai.in.th/setup to create the first administrator.
LITSTORM_BOOTSTRAP_CODE=CHANGE_ME
DEEPLIT_DB_PASSWORD=CHANGE_ME
SEARXNG_SECRET=CHANGE_ME

# --- MedicalReviewerAgent ---
MRA_DB_PASSWORD=CHANGE_ME
MRA_SEARXNG_SECRET=CHANGE_ME
MRA_IP_HASH_SALT=CHANGE_ME
MRA_OPENROUTER_API_KEY=CHANGE_ME
# DeepLit's key at MRA: set in both on deploy (mra-link, deeplit-link). Must start with mra_.
MRA_SERVICE_API_KEY=mra_CHANGE_ME
# Optional: budget | balanced | claude | gemini
MRA_LLM_PRESET=budget
MRA_MAX_USD_PER_DAY=10
MRA_MAX_COST_PER_REVIEW_USD=0.25
# Optional academic API keys (empty: keyless).
MRA_NCBI_API_KEY=
MRA_OPENALEX_API_KEY=
MRA_OPENALEX_MAILTO=
MRA_S2_API_KEY=
