# Copy to .env and fill in. Everything here is what secrets.toml holds for a
# host run — the image carries no secrets.toml, and `auth.setting` falls
# through to the environment precisely so that it does not have to.
#
# One rule worth knowing: a value in secrets.toml cannot be overridden by an
# environment variable, only the other way round. That is not a problem here,
# because there is no secrets.toml in the container.

# --- Supabase ---------------------------------------------------------------
# Left unset the compose file supplies http://gateway:8000, which is Supabase
# by service name across its network. Set it only to point somewhere else.
# SUPABASE_URL=http://gateway:8000
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# --- Models -----------------------------------------------------------------
# Only what this deployment uses. The Models page writes the rest into the
# app-state volume, where it survives a restart and a new image.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# --- Embeddings, if Co-STORM is used ----------------------------------------
# ollama runs on this machine rather than in the stack, so it is reached
# through host.docker.internal — the compose file maps that to the host.
# ENCODER_PROVIDER=ollama
# OLLAMA_API_BASE=http://host.docker.internal:11434
# OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# --- Search -----------------------------------------------------------------
# SearXNG by service name, the same way deploy/research-ui reaches it.
# SEARXNG_URL=http://searxng:8080
# TAVILY_API_KEY=

# --- Never set this in a deployment -----------------------------------------
# STORM_DEV_USER skips sign-in. It belongs to a laptop and nowhere else.
# STORM_DEV_USER=1
