# The one door into the stack.
#
# A template, not a finished config: the nginx image runs envsubst over
# /etc/nginx/templates/*.template at startup, so ${LIT_STORM_BASE_PATH} is
# the single place the app's mount point is written. NGINX_ENVSUBST_FILTER
# keeps envsubst to that one name — without it, $http_upgrade and $host
# would be substituted to empty strings and the proxy would break in ways
# that look nothing like a templating problem.
#
# Everything behind this publishes no port, so the stack asks the host for
# exactly one. That is what lets two stacks share a machine: the host's
# ports are a single namespace, and a stack claiming six collides with
# anything wanting one of those six. It also makes the laptop the same shape
# as a host, so a path working here is evidence it will work deployed.

# Streamlit talks over a WebSocket, and nginx only upgrades a connection
# when it is asked to. Without this the app loads and then sits there: the
# page is served over HTTP, and the socket that carries every rerun fails.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;

    # Reports run to megabytes and Streamlit posts file uploads through here.
    client_max_body_size 64m;

    # Send relative Location headers. nginx's default builds an absolute URL
    # from its own listen port, which is 8080 inside the container and not
    # the port anyone typed — so the redirect from / landed the browser on
    # localhost:8080, which nothing serves. A relative Location keeps
    # whatever host and port the request arrived on, which is also what a
    # deployment behind 443 needs.
    absolute_redirect off;

    # A research can be minutes long and answers in one response. nginx's
    # default 60s read timeout would cut the connection while the model is
    # still writing, and the browser would see a 504 from a run that was
    # working.
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;

    # All of these live here, at the server level, and no `location` below
    # may add a proxy_set_header of its own — nginx does not merge them. A
    # location that sets one replaces the whole inherited set, so putting
    # `Upgrade` in a location silently dropped Host and all three
    # X-Forwarded headers with it. The app then saw `Host: app:8501`, the
    # upstream's own name, and its loopback check — the fence around the
    # sign-in bypass — refused a request that really did come from
    # localhost.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Here too, for the same reason. `$connection_upgrade` is "close" when a
    # request is not a WebSocket handshake, which is what a plain proxied
    # request wants anyway, so this is safe for every location.
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Nothing is served at the root: the app has a name here, so someone
    # typing the bare address is sent to it rather than met with a 404.
    location = / { return 301 /${LIT_STORM_BASE_PATH}/; }

    # Without these a browser asking for /x gets the page but resolves its
    # relative links against /, one level too high.
    location = /${LIT_STORM_BASE_PATH} { return 301 /${LIT_STORM_BASE_PATH}/; }
    location = /research { return 301 /research/; }
    location = /agents   { return 301 /agents/; }

    # --- the app ---------------------------------------------------------
    # No trailing slash on proxy_pass, so the prefix is kept: Streamlit is
    # told it lives here by STREAMLIT_SERVER_BASE_URL_PATH and serves every
    # path — the page, its static assets and /_stcore/stream — underneath
    # it. Strip the prefix and all three 404.
    location /${LIT_STORM_BASE_PATH}/ {
        proxy_pass http://app:8501;
        # Streamlit's own reconnect handles a dropped socket; buffering the
        # stream here would delay every rerun by nginx's buffer rather than
        # by the app's own speed.
        proxy_buffering off;
    }

    # --- the siblings ----------------------------------------------------
    # Whether the prefix is kept differs between them, and it is not a
    # style choice: each is told where it lives, or is not.

    # Kept. Nuxt is told it lives at /research/ (NUXT_APP_BASE_URL) and
    # builds its pages and asset URLs under it; handed "/" it answers 500.
    location /research/ {
        proxy_pass http://research-ui:3000;
    }

    # The same application, reached at the root, because its own client asks
    # for it there. Nuxt is told it lives at /research/ and builds its pages,
    # its assets and even its icon endpoint under that prefix — but the three
    # calls that do the work are written as `$fetch("/api/...")`, and a
    # leading slash in Nuxt bypasses app.baseURL. So the page loads from
    # /research/ and then posts to /api/feedback, which nothing served: every
    # run ended at an nginx 404 that the app reported as "could not get
    # questions from the model".
    #
    # Named one by one rather than taking all of /api/: the root is shared,
    # and a second sibling with the same habit should collide loudly here
    # rather than quietly answer from the wrong application.
    # The prefix is put back on, because Nitro honours app.baseURL where the
    # client did not: the handler really is at /research/api/feedback, and
    # asking for /api/feedback gets a 404 from the application itself, not
    # only from this proxy.
    location ~ ^/api/(research|report|feedback)$ {
        proxy_pass http://research-ui:3000/research/api/$1;
        # Both of the long ones stream Server-Sent Events. Buffered, nginx
        # holds the whole run and hands it over at the end, so a research
        # that is working looks like one that has hung.
        proxy_buffering off;
    }

    # Stripped. Our own page is told nothing and needs nothing: it fetches
    # "api/runs" relative, so it works at whatever path it is mounted.
    location /agents/ {
        proxy_pass http://agents-research:3000/;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
