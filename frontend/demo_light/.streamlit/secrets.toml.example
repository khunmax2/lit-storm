# Copy this file to secrets.toml in the same folder and fill in your own
# values. secrets.toml is gitignored; this template is not, so never put a
# real key in here.

# ============ Language model ============
# Which provider to call. The wrapper underneath is litellm, so anything it
# speaks to can be reached from here; these are the ones with a key name of
# their own. Default: "gemini".
#
#   gemini             GOOGLE_API_KEY       — models below have defaults
#   openrouter         OPENROUTER_API_KEY   — name the models yourself
#   groq               GROQ_API_KEY         — name the models yourself
#   openai             OPENAI_API_KEY       — name the models yourself
#   openai-compatible  LLM_API_KEY + LLM_API_BASE
#                      anything that speaks the OpenAI API: z.ai, Together,
#                      a model served on your own machine
LLM_PROVIDER = "gemini"

# https://ai.google.dev/gemini-api/docs/api-key
GOOGLE_API_KEY = ""
# OPENROUTER_API_KEY = ""      # https://openrouter.ai/keys
# GROQ_API_KEY = ""            # https://console.groq.com/keys

# Two models, by the work they do rather than by their size: the fast one
# asks the questions and plays the interviews, the strong one writes. Only
# Gemini ships defaults, because those ids are known to work here — for the
# others, take the ids from the provider's own model list. Write them as that
# provider writes them; the provider part is added for you.
# LLM_FAST_MODEL = ""
# LLM_STRONG_MODEL = ""

# Either role can sit on a different provider than the other — the questions
# somewhere cheap and fast, the writing somewhere strong. Set the provider as
# well as the model, and put both keys above.
# LLM_FAST_PROVIDER = "groq"
# LLM_STRONG_PROVIDER = "openrouter"

# Only for LLM_PROVIDER = "openai-compatible".
# LLM_API_BASE = "https://api.z.ai/api/paas/v4"
# LLM_API_KEY = ""

# ============ Accounts (Supabase) ============
# Dashboard -> Project Settings -> Data API
#   Project URL  -> SUPABASE_URL
#   anon public  -> SUPABASE_ANON_KEY
#
# The anon key is meant to be public — it is what the browser would hold in a
# normal Supabase app, and row-level security is what protects the data. The
# service_role key bypasses those policies entirely and must never go here.
#
# Leave both empty to run without accounts; the app will say so on the sign-in
# screen rather than failing.
SUPABASE_URL = ""
SUPABASE_ANON_KEY = ""

# ============ Interface development ============
# Signs a fabricated account in so the pages behind the gate can be worked on
# without signing in after every code edit. Only takes effect for a browser
# asking over localhost, and never touches Supabase. Leave it out of anything
# you deploy; see the README.
# STORM_DEV_USER = "1"
# STORM_DEV_ROLE = "member"
