# Copy this file to secrets.toml in the same folder and fill in your own
# values. secrets.toml is gitignored; this template is not, so never put a
# real key in here.

# ============ Language model ============
# https://ai.google.dev/gemini-api/docs/api-key
GOOGLE_API_KEY = ""

# ============ Accounts (Supabase) ============
# Dashboard -> Project Settings -> Data API
#   Project URL  -> SUPABASE_URL
#   anon public  -> SUPABASE_ANON_KEY
#
# The anon key is meant to be public — it is what the browser would hold in a
# normal Supabase app, and row-level security is what protects the data. The
# service_role key bypasses those policies entirely and must never go here.
#
# Leave both empty to run without accounts; the app will say so on the sign-in
# screen rather than failing.
SUPABASE_URL = ""
SUPABASE_ANON_KEY = ""

# ============ Interface development ============
# Signs a fabricated account in so the pages behind the gate can be worked on
# without signing in after every code edit. Only takes effect for a browser
# asking over localhost, and never touches Supabase. Leave it out of anything
# you deploy; see the README.
# STORM_DEV_USER = "1"
# STORM_DEV_ROLE = "member"
