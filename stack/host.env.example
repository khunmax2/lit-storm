# Copy to stack/host.env on the host, fill in, chmod 600. Never committed.

# The images the GHCR workflow published for the deploy tag: the digests
# from the run's summary (docs/deploy/HOST-203.md §1). A digest, not a tag:
# what runs is exactly what was built from the tag.
LITSTORM_SERVER_IMAGE=ghcr.io/khunmax2/lit-storm-server@sha256:...
LITSTORM_WEB_IMAGE=ghcr.io/khunmax2/lit-storm-web@sha256:...

# The loopback port the host's nginx forwards /litstorm to (§0: must be free).
LITSTORM_HOST_PORT=10340

# Where users reach it; set-password links are made from this.
LITSTORM_PUBLIC_URL=https://203.185.144.41/litstorm

# SearXNG's own secret: openssl rand -hex 32
SEARXNG_SECRET=

# API processes (default 2). Each serves about 60 requests a second; raise
# to 3-4 past about 100 people watching live Runs at once. At most 4: the
# database allows connections for 4 (docs/deploy/HOST-203.md §0).
# LITSTORM_API_WORKERS=2
